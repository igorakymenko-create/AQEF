{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/igorakymenko-create/AQEF/conformance-tests/harness/schemas/0.4/adapter-error.schema.json",
  "title": "Adapter error 0.4",
  "description": "Why an operation produced no SUT outcome. A SUT rejection is not an error: it is an outcome (adapter-response, sut.outcome = rejected).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "origin",
    "phase",
    "code",
    "message",
    "retryable"
  ],
  "properties": {
    "origin": {
      "$ref": "common.schema.json#/$defs/origin"
    },
    "phase": {
      "$ref": "common.schema.json#/$defs/phase"
    },
    "code": {
      "anyOf": [
        {
          "enum": [
            "CONTRACT_VERSION_MISMATCH",
            "SCHEMA_INVALID",
            "ADAPTER_SURFACE_UNSUPPORTED",
            "ADAPTER_MAPPING_FAILED",
            "CREDENTIAL_UNAVAILABLE",
            "HARNESS_SETUP_FAILED",
            "HARNESS_SELF_TEST_FAILED",
            "HARNESS_INTERNAL",
            "SUT_TRANSPORT_FAILED",
            "SUT_TIMEOUT",
            "SUT_SERVER_ERROR",
            "SUT_MALFORMED_RESPONSE",
            "OBSERVATION_INCOMPLETE",
            "OPERATION_TIMEOUT"
          ]
        },
        {
          "type": "string",
          "pattern": "^X-[A-Z0-9_]+$"
        }
      ]
    },
    "message": {
      "type": "string"
    },
    "retryable": {
      "type": "boolean"
    },
    "sut_status": {
      "type": "integer",
      "minimum": 100,
      "maximum": 599
    },
    "evidence_ref": {
      "$ref": "common.schema.json#/$defs/ref"
    }
  }
}
