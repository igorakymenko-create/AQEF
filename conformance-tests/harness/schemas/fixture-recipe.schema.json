{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/igorakymenko-create/AQEF/conformance-tests/harness/schemas/0.5/fixture-recipe.schema.json",
  "title": "Fixture recipe 0.4",
  "description": "Machine-readable form of a CTS fixture (CTS 2.7). The CTS text is authoritative; a recipe that differs from it is wrong.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixture_id",
    "recipe_version",
    "cts_ref",
    "base",
    "steps",
    "setup_checks",
    "cleanup"
  ],
  "properties": {
    "fixture_id": {
      "type": "string",
      "pattern": "^F-[A-Z-]+$"
    },
    "recipe_version": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "cts_ref": {
      "type": "string",
      "description": "CTS revision and section, e.g. 'WD7 §2.7'."
    },
    "base": {
      "type": "string",
      "pattern": "^F-[A-Z-]+$"
    },
    "base_changes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^F-[A-Z-]+$"
      }
    },
    "behaviors": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "endpoint_id → behavior code at the start of setup."
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_id",
          "operation",
          "arguments"
        ],
        "properties": {
          "step_id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "operation": {
            "$ref": "common.schema.json#/$defs/operation"
          },
          "arguments": {
            "type": "object"
          },
          "actor_ref": {
            "$ref": "common.schema.json#/$defs/ref"
          },
          "after": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/id"
            }
          }
        }
      }
    },
    "setup_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "predicate"
        ],
        "properties": {
          "check_id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "predicate": {
            "type": "string",
            "description": "Human-readable in 0.3; the Stage C profile gives each a machine form."
          },
          "from_step": {
            "$ref": "common.schema.json#/$defs/id"
          }
        }
      }
    },
    "cleanup": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      }
    },
    "fixture_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    }
  }
}
